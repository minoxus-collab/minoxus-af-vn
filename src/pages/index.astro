---
// src/pages/index.astro
import MainLayout from '../layout/MainLayout.astro';
---

<MainLayout title="MINOXUS | Home">
  <!-- NAVBAR -->
  

  <main class="max-w-[1100px] mx-auto px-6">
    
    <!-- HERO GRID -->
    <section class="py-12 md:py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5 auto-rows-[220px]">
        
        <!-- Ô 1 (Tall card) -->
        <div class="bg-[#2C6B9E] hover:bg-[#1F5682] transition-all duration-500 text-white p-8 relative cursor-pointer flex flex-col justify-center items-center lg:row-span-2 lg:col-span-1 group shadow-sm hover:shadow-md" data-modal="modal-social">
          <span class="absolute top-6 right-6 text-xl font-light border border-white/40 rounded-full w-7 h-7 flex items-center justify-center pb-0.5 group-hover:bg-white group-hover:text-[#2C6B9E] transition-colors duration-300">+</span>
          <h3 class="font-light text-[18px] uppercase tracking-[0.2em] text-center mt-12">SOCIAL<br/>MEDIA</h3>
          <span class="absolute bottom-8 left-8 text-2xl font-light border border-white rounded-full w-10 h-10 flex items-center justify-center transform group-hover:translate-x-2 transition-transform duration-500">→</span>
        </div>
        
        <!-- Các Ô còn lại -->
        {
          [
            { id: 'modal-3d', title: 'MÔ HÌNH 3D TỪ<br/>BÌA CÁT TÔNG', bold: false },
            { id: 'modal-business', title: 'KINH DOANH', bold: true },
            { id: 'modal-design', title: 'THIẾT KẾ', bold: true },
            { id: 'modal-editor', title: 'EDITOR', bold: true },
            { id: 'modal-content', title: 'CONTENT<br/>WRITER', bold: false },
            { id: 'modal-template', title: 'TEMPLATE<br/>WEBSITE', bold: false }
          ].map((item) => (
            <div class="bg-[#2C6B9E] hover:bg-[#1F5682] transition-all duration-500 text-white p-8 relative cursor-pointer flex items-center justify-center text-center group shadow-sm hover:shadow-md" data-modal={item.id}>
              <span class="absolute top-5 right-5 text-lg font-light border border-white/40 rounded-full w-6 h-6 flex items-center justify-center pb-0.5 group-hover:bg-white group-hover:text-[#2C6B9E] transition-colors duration-300">+</span>
              <h3 class={`${item.bold ? 'font-bold text-[20px]' : 'font-light text-[18px] leading-[1.6]'} uppercase tracking-[0.15em]`} set:html={item.title}></h3>
            </div>
          ))
        }
      </div>
    </section>

    <!-- SECTION GIỚI THIỆU -->
    <section class="py-16 md:py-24 flex flex-col gap-24 md:gap-32">
      
      <!-- Block 1 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-20 items-center">
        <img src="/images/home-mo-hinh-3d-tu-carton.webp" alt="Mô hình 3D từ bìa cát tông" class="aspect-[3/4] w-full object-cover shadow-sm" />
        <div class="flex flex-col text-center md:text-right">
          <h2 class="font-bold text-[40px] md:text-[54px] text-[#2C6B9E] uppercase tracking-wide leading-[1.1] mb-2">MÔ HÌNH 3D<br/>TỪ BÌA CÁT TÔNG</h2>
          <p class="font-light text-[13px] text-[#2C6B9E] opacity-80 mb-10 tracking-[0.3em] uppercase">CHUYÊN MÔN</p>
          <p class="text-[16px] text-[#333333] font-light uppercase leading-[2] tracking-[0.1em]">
            Tôi yêu thích việc biến những tấm bìa cát tông tưởng chừng đơn giản thành những mô hình 3D và món đồ trang trí độc đáo. Từ một ý tưởng ban đầu, tôi sẽ từng bước hiện thực hóa thành một sản phẩm hoàn chỉnh, chỉn chu và mang dấu ấn riêng.
          </p>
        </div>
      </div>
      
      <!-- Block 2 (Reverse) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-20 items-center">
        <div class="flex flex-col text-center md:text-left order-2 md:order-1">
          <h2 class="font-bold text-[40px] md:text-[54px] text-[#2C6B9E] uppercase tracking-wide leading-[1.1] mb-2">EDITOR</h2>
          <p class="font-light text-[13px] text-[#2C6B9E] opacity-80 mb-10 tracking-[0.3em] uppercase">BỔ TRỢ</p>
          <p class="text-[16px] text-[#333333] font-light uppercase leading-[2] tracking-[0.1em]">
            Với khả năng sáng tạo và nhạy bén với xu hướng, tôi biến những thước phim thô ban đầu thành những video chỉn chu, có cảm xúc và dễ chạm đến người xem. Mỗi đoạn footage bạn gửi đều là một phần nguyên liệu để tạo nên một sản phẩm hoàn chỉnh và đáng nhớ.
          </p>
        </div>
        <img src="/images/home-editor.webp" alt="Dịch vụ chỉnh sửa video" class="aspect-[3/4] w-full object-cover shadow-sm order-1 md:order-2" />
      </div>

      <!-- Block 3 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-20 items-center">
        <img src="/images/home-content-writing-service.webp" alt="Sáng tạo nội dung" class="aspect-[3/4] w-full object-cover shadow-sm" />
        <div class="flex flex-col text-center md:text-right">
          <h2 class="font-bold text-[40px] md:text-[54px] text-[#2C6B9E] uppercase tracking-wide leading-[1.1] mb-2">CONTENT WRITER</h2>
          <p class="font-light text-[13px] text-[#2C6B9E] opacity-80 mb-10 tracking-[0.3em] uppercase">KỸ NĂNG</p>
          <p class="text-[16px] text-[#333333] font-light uppercase leading-[2] tracking-[0.1em]">
            Viết lách là một kỹ năng quan trọng trong quá trình xây dựng thương hiệu. Một nội dung tốt không chỉ truyền tải thông tin, mà còn giúp thương hiệu thể hiện cá tính và tạo được dấu ấn riêng trong mắt người đọc.
          </p>
        </div>
      </div>

    </section>

    <!-- CONTACT FORM -->
<section class="pt-20 pb-28 border-t border-gray-100">
      <div class="max-w-[700px] mx-auto">
        <h2 class="font-bold text-4xl md:text-[44px] text-center text-[#2C6B9E] mb-14 tracking-[0.15em] uppercase">CONTACT</h2>
        
        <form id="contact-form" class="flex flex-col gap-10">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="flex flex-col">
              <label class="text-[13px] font-medium text-[#2C6B9E] mb-2 uppercase tracking-[0.2em]">FULL NAME</label>
              <input type="text" name="name" required class="text-[16px] font-light py-3 bg-transparent border-b border-[#2C6B9E]/40 text-[#0D0D0D] outline-none focus:border-[#2C6B9E] transition-colors placeholder-gray-400" placeholder="Họ và tên..." />
            </div>
            <div class="flex flex-col">
              <label class="text-[13px] font-medium text-[#2C6B9E] mb-2 uppercase tracking-[0.2em]">EMAIL</label>
              <input type="email" name="email" required class="text-[16px] font-light py-3 bg-transparent border-b border-[#2C6B9E]/40 text-[#0D0D0D] outline-none focus:border-[#2C6B9E] transition-colors placeholder-gray-400" placeholder="Email của bạn..." />
            </div>
          </div>
          
          <div class="flex flex-col">
            <label class="text-[13px] font-medium text-[#2C6B9E] mb-2 uppercase tracking-[0.2em]">CONTENT</label>
            <textarea name="message" required class="text-[16px] font-light py-3 bg-transparent border-b border-[#2C6B9E]/40 text-[#0D0D0D] outline-none focus:border-[#2C6B9E] transition-colors h-24 resize-none placeholder-gray-400" placeholder="Nội dung muốn liên hệ..."></textarea>
          </div>
          
          <div class="flex flex-col items-center mt-6 gap-4">
            <button type="submit" id="contact-submit-btn" class="bg-[#2C6B9E] hover:bg-[#0D0D0D] text-white font-medium text-[15px] uppercase px-20 py-4 tracking-[0.2em] transition-colors duration-500 shadow-sm hover:shadow-md">SEND MESSAGE</button>
            <!-- Dòng thông báo trạng thái -->
            <p id="contact-status" class="text-sm tracking-widest font-light opacity-0 transition-opacity duration-300"></p>
          </div>
        </form>
      </div>
    </section>
  </main>

  <!-- MODALS -->
  {
    [
      { 
        id: 'modal-social', 
        title: 'SOCIAL MEDIA', 
        subtitle: 'MỞ RỘNG',
        content: 'Từ việc lên ý tưởng, xây dựng nội dung đến cách một bài đăng được đưa đến đúng người xem. Tôi thích tìm hiểu cách nội dung hoạt động trên từng nền tảng và biến những ý tưởng đơn giản thành thứ đủ thú vị để người khác dừng lại, xem và nhớ đến.' 
      },
      { 
        id: 'modal-3d', 
        title: 'MÔ HÌNH 3D TỪ BÌA CARTON', 
        subtitle: 'CỐT LÕI',
        content: 'Tôi thích biến những vật liệu quen thuộc thành những thứ có hình dáng và câu chuyện riêng. Từ những tấm bìa carton đơn giản, tôi tự lên ý tưởng, cắt ghép và hoàn thiện thành mô hình 3D hoặc những món đồ trang trí mang dấu ấn cá nhân.' 
      },
      { 
        id: 'modal-business', 
        title: 'KINH DOANH', 
        subtitle: 'THỰC TIỄN',
        content: 'Kinh doanh không chỉ là bán một sản phẩm, mà còn là hiểu khách hàng đang cần gì và tìm cách đưa sản phẩm đến đúng người. Tôi thích quan sát thị trường, thử nghiệm cách tiếp cận và tìm ra những cách đơn giản hơn để biến một ý tưởng thành giá trị thực tế.' 
      },
      { 
        id: 'modal-design', 
        title: 'THIẾT KẾ', 
        subtitle: 'SÁNG TẠO',
        content: 'Tôi xem thiết kế là cách biến một ý tưởng thành thứ có thể nhìn thấy và cảm nhận được. Từ hình ảnh, bố cục đến những chi tiết nhỏ, tôi luôn cố gắng tìm ra cách thể hiện vừa đẹp mắt, vừa đúng với mục đích ban đầu.' 
      },
      { 
        id: 'modal-editor', 
        title: 'EDITOR', 
        subtitle: 'MỞ RỘNG',
        content: 'Một đoạn footage tốt chỉ mới là điểm bắt đầu. Tôi thích chọn lọc, cắt ghép và thêm nhịp điệu phù hợp để biến những thước phim ban đầu thành một video có câu chuyện, có cảm xúc và đủ khiến người xem muốn xem tiếp.' 
      },
      { 
        id: 'modal-content', 
        title: 'CONTENT WRITER', 
        subtitle: 'BỔ TRỢ',
        content: 'Viết là một cách để biến suy nghĩ thành thứ người khác có thể hiểu và ghi nhớ. Tôi thích tìm cách diễn đạt những ý tưởng tưởng chừng đơn giản thành nội dung rõ ràng, tự nhiên và mang đúng cá tính của thương hiệu.' 
      },
      { 
        id: 'modal-template', 
        title: 'TEMPLATE WEBSITE', 
        subtitle: 'THỬ NGHIỆM',
        content: 'Tôi thích tạo ra những giao diện website vừa có tính thẩm mỹ, vừa có thể sử dụng thực tế. Mỗi template là một lần thử nghiệm với bố cục, trải nghiệm người dùng và cách nội dung được trình bày sao cho mọi thứ trở nên đơn giản và dễ tiếp cận hơn.' 
      }
    ].map((modal) => (
      <div id={modal.id} class="modal-overlay fixed inset-0 bg-white/95 backdrop-blur-md z-[1000] flex items-center justify-center opacity-0 invisible transition-all duration-500 overflow-y-auto">
        <button aria-label="Đóng" class="modal-close fixed top-8 right-10 text-[#0D0D0D] hover:text-[#2C6B9E] text-4xl font-light transition-colors transform hover:rotate-90 duration-300 z-50">✕</button>
        <div class="text-center p-8 max-w-[800px] my-auto transform transition-transform duration-700 translate-y-8 w-full">
          <h2 class="font-bold text-4xl md:text-[54px] text-[#2C6B9E] tracking-wide mb-2 uppercase leading-tight">{modal.title}</h2>
          <p class="font-light text-[13px] text-[#2C6B9E] opacity-80 mb-8 tracking-[0.3em] uppercase">{modal.subtitle}</p>
          <p class="text-[16px] text-[#333333] font-light leading-[2] tracking-[0.05em]">{modal.content}</p>
        </div>
      </div>
    ))
  }
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Menu
    const hamburgerBtn = document.getElementById('hamburger-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (hamburgerBtn && mobileMenu) {
      hamburgerBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        mobileMenu.classList.toggle('flex');
      });
    }

    // Modal
    const gridCards = document.querySelectorAll('[data-modal]');
    gridCards.forEach(card => {
      card.addEventListener('click', () => {
        const modalId = (card as HTMLElement).dataset.modal;
        if (!modalId) return;
        const overlay = document.getElementById(modalId);
        if (overlay) {
          overlay.classList.remove('opacity-0', 'invisible');
          const content = overlay.querySelector('.max-w-\\[800px\\]');
          if (content) {
            content.classList.remove('translate-y-8');
            content.classList.add('translate-y-0');
          }
          document.body.style.overflow = 'hidden';
        }
      });
    });

    const closeTriggers = document.querySelectorAll('.modal-close, .modal-overlay');
    closeTriggers.forEach(el => {
      el.addEventListener('click', (e) => {
        if (e.target === el) {
          const overlay = el.closest('.modal-overlay');
          if (overlay) {
            const content = overlay.querySelector('.max-w-\\[800px\\]');
            if (content) {
              content.classList.remove('translate-y-0');
              content.classList.add('translate-y-8');
            }
            setTimeout(() => {
              overlay.classList.add('opacity-0', 'invisible');
              document.body.style.overflow = '';
            }, 200);
          }
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const openModals = document.querySelectorAll('.modal-overlay:not(.opacity-0)');
        openModals.forEach(overlay => {
          const content = overlay.querySelector('.max-w-\\[800px\\]');
          if (content) {
            content.classList.remove('translate-y-0');
            content.classList.add('translate-y-8');
          }
          setTimeout(() => {
            overlay.classList.add('opacity-0', 'invisible');
            document.body.style.overflow = '';
          }, 200);
        });
      }
    });

    // --- XỬ LÝ FORM LIÊN HỆ ---
    const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
    const contactBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
    const contactStatus = document.getElementById('contact-status');

    if (contactForm && contactBtn && contactStatus) {
      contactForm.addEventListener('submit', async (e) => {
        e.preventDefault(); 
        
        const formData = new FormData(contactForm);
        const data = Object.fromEntries(formData);
        
        const originalText = contactBtn.innerText;
        contactBtn.innerText = 'SENDING...';
        contactBtn.disabled = true;
        contactBtn.classList.add('opacity-70', 'cursor-not-allowed');
        contactStatus.classList.remove('opacity-100');
        contactStatus.classList.add('opacity-0');

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });

          if (res.ok) {
            contactForm.reset();
            contactStatus.innerText = 'GỬI TIN NHẮN THÀNH CÔNG!';
            contactStatus.classList.remove('text-red-500');
            contactStatus.classList.add('text-[#2C6B9E]', 'opacity-100');
          } else {
            throw new Error('Lỗi server');
          }
        } catch (err) {
          contactStatus.innerText = 'CÓ LỖI XẢY RA, VUI LÒNG THỬ LẠI.';
          contactStatus.classList.remove('text-[#2C6B9E]');
          contactStatus.classList.add('text-red-500', 'opacity-100');
        } finally {
          contactBtn.innerText = originalText;
          contactBtn.disabled = false;
          contactBtn.classList.remove('opacity-70', 'cursor-not-allowed');
          
          setTimeout(() => {
            contactStatus.classList.remove('opacity-100');
            contactStatus.classList.add('opacity-0');
          }, 5000);
        }
      });
    }
  });
</script>