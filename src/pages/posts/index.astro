---
// src/pages/posts/index.astro
import MainLayout from '../../layout/MainLayout.astro';
import CategoryTabs from '../../components/CategoryTabs.astro';
import PostCard from '../../components/PostCard.astro';
import { getPaginatedPosts } from '../../logic/post.ts';
import { getPageWindow } from '../../utils/pagination.ts';

const LIMIT = 9;
const pageParam = Number(Astro.url.searchParams.get('page')) || 1;
const { posts, totalCount } = await getPaginatedPosts({ page: pageParam, limit: LIMIT });
const totalPages = Math.max(1, Math.ceil(totalCount / LIMIT));
const currentPage = Math.min(pageParam, totalPages);
const pageWindow = getPageWindow(currentPage, totalPages);
---

<MainLayout title="MINOXUS | Tất Cả Bài Viết">
  <div class="py-6">
    <!-- Thanh Tab danh mục từ Phase 14 -->
    <CategoryTabs activeType="all" />

    <div class="text-center pt-6 pb-2 px-4">
      <h1 class="font-oswald uppercase text-[clamp(26px,4vw,38px)] text-[#2C6B9E]">TẤT CẢ BÀI VIẾT</h1>
      <p class="text-brand-mute text-sm mt-2 max-w-[560px] mx-auto font-light">
        Tổng hợp toàn bộ kiến thức, hướng dẫn thực chiến và đánh giá công cụ sáng tạo nội dung.
      </p>
    </div>

    <!-- Lưới bài viết Phase 14 -->
    <div class="max-w-[1100px] mx-auto px-6">
      {posts.length === 0 ? (
        <p class="text-center text-brand-mute py-20">Chưa có bài viết nào được xuất bản.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7 py-10">
          {posts.map((p) => <PostCard post={p} />)}
        </div>
      )}
    </div>

    <!-- Phân trang -->
    {totalPages > 1 && (
      <div class="flex justify-center gap-2 pb-16 font-oswald text-sm">
        {pageWindow.map((p) =>
          p === '...' ? (
            <span class="w-9 h-9 flex items-center justify-center text-brand-mute">…</span>
          ) : (
            <a
              href={`/posts?page=${p}`}
              class={`w-9 h-9 rounded-full border flex items-center justify-center transition-colors
                ${p === currentPage ? 'bg-[#2C6B9E] border-[#2C6B9E] text-white' : 'border-gray-200 hover:border-[#2C6B9E]'}`}
            >
              {p}
            </a>
          )
        )}
      </div>
    )}
  </div>
</MainLayout>